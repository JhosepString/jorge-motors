="700" width="380" height="130" as="geometry"/></mxCell><mxCell id="store" value="&lt;font style=&quot;font-size:11px&quot;&gt;«contenedor»&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Almacén de adjuntos&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[archivos locales → Blob]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PDF, PNG y JPEG&lt;br&gt;de facturas&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="820" y="450" width="170" height="130" as="geometry"/></mxCell><mxCell id="wrk" value="&lt;font style=&quot;font-size:11px&quot;&gt;«contenedor»&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Worker de notificaciones&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Node.js · mismo código]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Reclama tareas del Outbox y reintenta&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="820" y="700" width="170" height="130" as="geometry"/></mxCell><mxCell id="entra" value="&lt;font style=&quot;font-size:11px&quot;&gt;«sistema externo»&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Identidad, roles de&lt;br&gt;aplicación y claves&lt;br&gt;públicas (JWKS)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=#5A5A5A;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="10" y="300" width="180" height="140" as="geometry"/></mxCell><mxCell id="mail" value="&lt;font style=&quot;font-size:11px&quot;&gt;«sistema externo · pendiente»&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Servicio de correo&lt;/b&gt;&lt;br&gt;&lt;font style=&qu