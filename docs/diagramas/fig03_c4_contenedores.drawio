<mxfile host="app.diagrams.net"><diagram name="fig03_c4_contenedores" id="fig03_c4_contenedores"><mxGraphModel dx="1340" dy="930" grid="1" gridSize="10" guides="1" page="1" pageWidth="1340" pageHeight="930" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="admh" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#FFFFFF;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="335" y="6" width="50" height="50" as="geometry"/></mxCell><mxCell id="adm" value="&lt;font style=&quot;font-size:11px&quot;&gt;«persona»&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Administrador&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Gestiona inventario, compras y reportes&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="44" width="260" height="96" as="geometry"/></mxCell><mxCell id="mech" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#FFFFFF;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="675" y="6" width="50" height="50" as="geometry"/></mxCell><mxCell id="mec" value="&lt;font style=&quot;font-size:11px&quot;&gt;«persona»&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Mecánico&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Consulta el stock y registra salidas&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="570" y="44" width="260" height="96" as="geometry"/></mxCell><mxCell id="bnd" value="&lt;b&gt;Sistema de Gestión de Inventario “Jorge Motors”&lt;/b&gt;&lt;br&gt;[sistema de software]" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888888;dashed=1;verticalAlign=bottom;align=left;spacingLeft=12;fontSize=12;fontColor=#333333;spacingBottom=8;" vertex