<mxfile host="app.diagrams.net"><diagram name="fig01_arquitectura_capas" id="fig01_arquitectura_capas"><mxGraphModel dx="1000" dy="870" grid="1" gridSize="10" guides="1" page="1" pageWidth="1000" pageHeight="870" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;Arquitectura en capas del sistema implementado (monolito modular)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontColor=#222222;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="960" height="34" as="geometry"/></mxCell><mxCell id="L1" value="&lt;b style=&quot;font-size:15px&quot;&gt;Presentación · SPA React 19 + Vite + TypeScript&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Navegación por rol, vista previa del impacto y reintentos con la misma clave de idempotencia&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D0D0;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="52" width="960" height="132" as="geometry"/></mxCell><mxCell id="L1b" value="Implementada · 15 pruebas" style="rounded=1;arcSize=50;html=1;fillColor=#E8F5E4;strokeColor=#9BC59B;fontColor=#2D5A2D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770" y="64" width="195" height="28" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;Administrador&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;7 pantallas&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F6F7F9;strokeColor=#C9CED6;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="116" width="215" height="50" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;Mecánico&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;3 pantallas, sin precios&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F6F7F9;strokeColor=#C9CED6;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="272" y="116" width="215" height="50" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;MSAL · Entra ID&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Authorization Code + PKCE&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F6F7F9;strokeColor=#C9CED6;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="504" y="116" width="215" height="50" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;Cliente REST&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;token solo en la cabecera&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F6F7F9;strokeColor=#C9CED6;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="736" y="116" width="225" height="50" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;Cliente-servidor / REST&lt;/b&gt;&lt;br&gt;JSON sobre HTTPS en /api/v1 · Authorization: Bearer" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="505" y="190" width="470" height="42" as="geometry"/></mxCell><mxCell id="L2" value="&lt;b style=&quot;font-size:15px&quot;&gt;Entrada HTTP, aplicación y dominio · API Node.js 24 + Express 5 + TypeScript&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D0D0;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="238" width="960" height="470" as="geometry"/></mxCell><mxCell id="L2b" value="Implementada · 98 pruebas" style="rounded=1;arcSize=50;html=1;fillColor=#E8F5E4;strokeColor=#9BC59B;fontColor=#2D5A2D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770" y="250" width="195" height="28" as="geometry"/></mxCell><mxCell id="tx1" value="&lt;b&gt;Chain of Responsibility&lt;/b&gt;: cada eslabón llama a next() o detiene la petición (401 / 403 / 400)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="900" height="26" as="geometry"/></mxCell><mxCell id="c1" value="requestContext" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="312" width="135" height="48" as="geometry"/></mxCell><mxCell id="c2" value="helmet · CORS&lt;br&gt;JSON 64 KB" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="197" y="312" width="135" height="48" as="geometry"/></mxCell><mxCell id="c3" value="authenticate&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;token Entra&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="354" y="312" width="135" height="48" as="geometry"/></mxCell><mxCell id="c4" value="resolveUser&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;perfil activo&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="511" y="312" width="135" height="48" as="geometry"/></mxCell><mxCell id="c5" value="requireRole" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="668" y="312" width="135" height="48" as="geometry"/></mxCell><mxCell id="c6" value="Zod (DTO)&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;→ controlador&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="825" y="312" width="135" height="48" as="geometry"/></mxCell><mxCell id="tx2" value="&lt;font color=&quot;#555555&quot;&gt;Si un eslabón falla → &lt;b&gt;errorHandler&lt;/b&gt;: respuesta uniforme con X-Request-Id y registro en la auditoría&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="366" width="900" height="22" as="geometry"/></mxCell><mxCell id="tx3" value="&lt;b&gt;Aplicación y dominio&lt;/b&gt;: cada caso de uso es una Facade que trabaja dentro de su Unit of Work" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="398" width="900" height="26" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;InventarioFacade&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Facade + Unit of Work&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9F0FB;strokeColor=#4A7BD0;strokeWidth=2;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="205" height="70" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;TransactionalPublisher&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Observer · sujeto&lt;br&gt;evento StockCambiado&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="278" y="430" width="205" height="70" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;StockAlertObserver&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Observer · observador&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="516" y="430" width="205" height="70" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;Alerta + Outbox&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;State: Pendiente → Enviada → Atendida&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="754" y="430" width="205" height="70" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;ReportesFacade&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Facade · contexto&lt;br&gt;elige pdf o xlsx&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9F0FB;strokeColor=#4A7BD0;strokeWidth=2;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="205" height="70" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;InventoryReportStrategy&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Strategy · contrato&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="278" y="530" width="205" height="70" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;Pdf / ExcelInventoryStrategy&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;estrategias concretas&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="516" y="530" width="205" height="70" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;NotificationWorker&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;proceso aparte · reservas y reintentos&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF6E5;strokeColor=#E0A93B;dashed=1;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="754" y="530" width="205" height="70" as="geometry"/></mxCell><mxCell id="tx4" value="&lt;font color=&quot;#555555&quot;&gt;Otras fachadas: CatalogoFacade · ProveedoresFacade · FacturasFacade · AdjuntosFacade · InventoryReadFacade&lt;br&gt;Dominio: reglas puras de stock, alertas y facturas, sin dependencias de Express ni de SQL&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="615" width="920" height="40" as="geometry"/></mxCell><mxCell id="tx5" value="&lt;font color=&quot;#555555&quot;&gt;El envío real de correos (Azure Communication Services) está pendiente: el worker se probó con un transporte simulado&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="658" width="920" height="34" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;Repository + Unit of Work&lt;/b&gt; · node-mssql y T-SQL parametrizado&lt;br&gt;&lt;b&gt;SqlPoolSingleton&lt;/b&gt; (Singleton): un pool de conexiones por proceso" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="505" y="714" width="470" height="42" as="geometry"/></mxCell><mxCell id="L3" value="&lt;b style=&quot;font-size:15px&quot;&gt;Datos · SQL Server 2019 (local) / Azure SQL Database (destino) · esquema jm&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;12 tablas y 8 migraciones versionadas · CHECK, triggers de inmutabilidad, índices únicos filtrados y ROWVERSION&lt;br&gt;Adjuntos de factura: Adapter local en el demo → Blob Storage privado como destino&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D0D0;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="764" width="960" height="92" as="geometry"/></mxCell><mxCell id="L3b" value="Implementada · 119 pruebas" style="rounded=1;arcSize=50;html=1;fillColor=#E8F5E4;strokeColor=#9BC59B;fontColor=#2D5A2D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770" y="776" width="195" height="28" as="geometry"/></mxCell><mxCell id="ec2" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=bloc