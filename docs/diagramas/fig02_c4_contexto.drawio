<mxfile host="app.diagrams.net"><diagram name="fig02_c4_contexto" id="fig02_c4_contexto"><mxGraphModel dx="1100" dy="830" grid="1" gridSize="10" guides="1" page="1" pageWidth="1100" pageHeight="830" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="admh" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#FFFFFF;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="175" y="10" width="50" height="50" as="geometry"/></mxCell><mxCell id="adm" value="&lt;font style=&quot;font-size:11px&quot;&gt;«persona»&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;Administrador&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Dueño del taller: gestiona catálogo, proveedores,&lt;br&gt;compras, movimientos y reportes&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="48" width="280" height="110" as="geometry"/></mxCell><mxCell id="mech" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#FFFFFF;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="875" y="10" width="50" height="50" as="geometry"/></mxCell><mxCell id="mec" value="&lt;font style=&quot;font-size:11px&quot;&gt;«persona»&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;Mecánico&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Consulta el stock, registra salidas&lt;br&gt;y revisa su propio historial&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="48" width="280" height="110" as="geometry"/></mxCell><mxCell id="sys" value="&lt;font style=&quot;font-size:11px&quot;&gt;«sistema de software»&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:16px&quot;&gt;Sistema de Gestión de Inventario&lt;br&gt;“Jorge Motors”&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Entradas, salidas y stock, compras,&lt;br&gt;reportes PDF/Excel, alertas&lt;br&gt;de bajo stock y auditoría&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="330" width="300" height="170" as="geometry"/></mxCell><mxCell id="entra" value="&lt;font style=&quot;font-size:11px&quot;&gt;«sistema externo»&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Identidad de los empleados&lt;br&gt;y roles de aplicación&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=#5A5A5A;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="210" height="130" as="geometry"/></mxCell><mxCell id="mail" value="&lt;font style=&quot;font-size:11px&quot;&gt;«sistema externo · pendiente»&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;Servicio de correo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Azure Communication&lt;br&gt;Services Email&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#8A8A8A;dashed=1;fontColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="870" y="350" width="210" height="130" as="geometry"/></mxCell><mxCell id="provh" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=#FFFFFF;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="915" y="640" width="50" height="50" as="geometry"/></mxCell><mxCell id="prov" value="&lt;font style=&quot;font-size:11px&quot;&gt;«persona externa»&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;Proveedor de repuestos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Recibe los avisos de reposición;&lt;br&gt;no tiene cuenta en el sistema&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=#5A5A5A;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="800" y="678" width="280" height="110" as="geometry"/></mxCell><mxCell id="clih" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=#FFFFFF;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="175" y="640" width="50" height="50" as="geometry"/></mxCell><mxCell id="cli" value="&lt;font style=&quot;font-size:11px&quot;&gt;«interesado indirecto»&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;Cliente del taller&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Beneficiario indirecto: hay stock&lt;br&gt;y la atención es más rápida&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=#5A5A5A;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="678" width="280" height="110" as="geometry"/></mxCell><mxCell id="nota" value="&lt;font color=&quot;#666666&quot;&gt;Líneas discontinuas: integración prevista o relación indirecta. El envío real de correo está pendiente; el aviso queda encolado de forma durable.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="800" width="1060" height="24" as="geometry"/></mxCell><mxCell id="e1" value="Gestiona el inventario y consulta reportes&lt;br&gt;&lt;i&gt;[HTTPS · navegador web]&lt;/i&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#888888;fontColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="adm" target="sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="Registra salidas y consulta el stock&lt;br&gt;&lt;i&gt;[HTTPS · navegador web]&lt;/i&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#888888;fontColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mec" target="sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="Autentica y&lt;br&gt;valida tokens&lt;br&gt;&lt;i&gt;[OAuth 2.0 · PKCE]&lt;/i&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#888888;fontColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sys" target="entra"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="Envía avisos&lt;br&gt;de bajo stock&lt;br&gt;&lt;i&gt;[Outbox · worker]&lt;/i&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#888888;fontColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="sys" target="mail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="Aviso de reposición&lt;br&gt;&lt;i&gt;[correo electrónico]&lt;/i&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#888888;fontColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="mail" target="provh"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="Beneficio indirecto" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#888888;fontColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#AAAAAA;" edge="1" parent="1" source="sys" target="clih"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>