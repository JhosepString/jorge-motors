<mxfile host="app.diagrams.net"><diagram name="fig09_navegacion_roles" id="fig09_navegacion_roles"><mxGraphModel dx="1300" dy="720" grid="1" gridSize="10" guides="1" page="1" pageWidth="1300" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;Un único inicio de sesión con Microsoft lleva a cada rol a su propia navegación&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontColor=#222222;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="1100" height="30" as="geometry"/></mxCell><mxCell id="login" value="&lt;b&gt;Inicio de sesión&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;Microsoft Entra ID&lt;br&gt;(fig. 20)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9F0FB;strokeColor=#4A7BD0;strokeWidth=2;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="190" height="90" as="geometry"/></mxCell><mxCell id="me" value="&lt;b&gt;Perfil&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;GET /auth/me&lt;br&gt;rol verificado por la API&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F6F7F9;strokeColor=#C9CED6;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="250" y="300" width="170" height="90" as="geometry"/></mxCell><mxCell id="A" value="&lt;b&gt;Administrador&lt;/b&gt; &lt;font color=&quot;#555&quot;&gt;· menú lateral con 7 opciones&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D0D0;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontColor=#222222;fillColor=#F6F8FC;strokeColor=#C9D3E6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="460" y="50" width="820" height="360" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;Resumen&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;indicadores y prioridad&lt;br&gt;de reposición (fig. 21)&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="480" y="100" width="185" height="90" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;Inventario&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;+ categoría, + producto,&lt;br&gt;editar (fig. 22)&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="680" y="100" width="185" height="90" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;Registrar movimiento&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;entrada o salida con&lt;br&gt;vista previa (fig. 23)&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="880" y="100" width="185" height="90" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;Movimientos&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;historial global&lt;br&gt;(fig. 24)&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1080" y="100" width="185" height="90" as="geometry"/></mxCell><mxCell id="a5" value="&lt;b&gt;Reportes&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;filtros y descarga&lt;br&gt;PDF / Excel (fig. 25)&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="480" y="250" width="185" height="90" as="geometry"/></mxCell><mxCell id="a6" value="&lt;b&gt;Proveedores&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;alta, edición y&lt;br&gt;desactivación (fig. 26)&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="680" y="250" width="185" height="90" as="geometry"/></mxCell><mxCell id="a7" value="&lt;b&gt;Compras&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;facturas, recepción&lt;br&gt;y adjuntos (fig. 27)&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="880" y="250" width="185" height="90" as="geometry"/></mxCell><mxCell id="a7b" value="&lt;b&gt;Detalle de factura&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;confirmar recepción,&lt;br&gt;anular, documentos&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F6F7F9;strokeColor=#C9CED6;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1080" y="250" width="185" height="90" as="geometry"/></mxCell><mxCell id="ax" value="&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;Desde Resumen se abre Registrar movimiento; cada opción del menú lleva directamente a su pantalla.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="480" y="352" width="780" height="40" as="geometry"/></mxCell><mxCell id="M" value="&lt;b&gt;Mecánico&lt;/b&gt; &lt;font color=&quot;#555&quot;&gt;· menú reducido a 3 opciones, sin precios, reportes, compras ni entradas&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D0D0;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontColor=#222222;fillColor=#F6F8FC;strokeColor=#C9D3E6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="460" y="450" width="820" height="250" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b&gt;Consultar stock&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;búsqueda sin precios&lt;br&gt;(fig. 28)&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="480" y="510" width="200" height="90" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b&gt;Registrar salida&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;producto, cantidad, OT&lt;br&gt;y motivo (fig. 29)&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="750" y="510" width="200" height="90" as="geometry"/></mxCell><mxCell id="m3" value="&lt;b&gt;Mis movimientos&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;solo lo que él registró&lt;br&gt;(fig. 30)&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1020" y="510" width="200" height="90" as="geometry"/></mxCell><mxCell id="m2b" value="&lt;b&gt;Movimiento guardado&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;saldo resultante&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F6F7F9;strokeColor=#C9CED6;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="750" y="625" width="200" height="56" as="geometry"/></mxCell><mxCell id="nota" value="&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;La interfaz solo muestra las opciones del rol; la API vuelve a comprobar el rol en cada operación (una entrada enviada por un mecánico recibe 403 ROLE_FORBIDDEN). La gestión de usuarios se hace en Entra ID, no en la aplicación.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#555555;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="420" height="120" as="geometry"/></mxCell><mxCell id="e0" value="token" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#888888;fontColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="login" target="me"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#888888;fontColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#888888;" edge="1" parent="1" source="a7" target="a7b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ea" value="ADMINISTRADOR" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#888888;fontColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#888888;" edge="1" parent="1" source="me" target="a1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="310"/><mxPoint x="440" y="145"/></Array></mxGeometry></mxCell><mxCell id="ea3" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#888888;fontColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#BBBBBB;dashed=1;" edge="1" parent="1" source="a1" target="a3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="572" y="210"/><mxPoint x="972" y="210"/></Array></mxGeometry></mxCell><mxCell id="em" value="MECANICO" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#888888;fontColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#888888;" edge="1" parent="1" source="me" target="m1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="380"/><mxPoint x="440" y="555"/></Array></mxGeometry></mxCell><mxCell id="e12" value="elige repuesto" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#888888;fontColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#888888;" edge="1" parent="1" source="m1" target="m2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#888888;fontColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#888888;" edge="1" parent="1" source="m2" target="m2b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2b3" value="ver historial" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#888888;fontColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#888888;" edge="1" parent="1" source="m2b" target="m3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="653"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>