{
  "name": "@jorge-motors/backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "tsx --test tests/*.test.ts",
    "check": "pnpm run typecheck && pnpm test && pnpm run build",
    "test:sql": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/cli/migrate.ts",
    "auth:check": "node --env-file-if-exists=.env --import tsx src/cli/auth-check.ts",
    "db:user:add": "node --env-file-if-exists=.env --import tsx src/cli/register-user.ts",
    "outbox:status": "node --env-file-if-exists=.env --import tsx src/cli/outbox-status.ts",
    "worker:demo": "tsx --test tests/integration/outbox-sql.test.ts",
    "catalog:check": "node --env-file-if-exists=.env --import tsx src/cli/catalog-check.ts",
    "supplier:check": "node --env-file-if-exists=.env --import tsx src/cli/supplier-check.ts",
    "invoice:check": "node --env-file-if-exists=.env --import tsx src/cli/invoice-check.ts",
    "attachment:check": "node --env-file-if-exists=.env --import tsx src/cli/attachment-check.ts",
    "attachment:cleanup": "node --env-file-if-exists=.env --import tsx src/cli/attachment-cleanup.ts",
    "report:check": "node --env-file-if-exists=.env --import tsx src/cli/report-check.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.14.0",
    "@azure/storage-blob": "^12.34.0",
    "@fontsource/noto-sans": "^5.3.0",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "fontkit": "^2.0.4",
    "helmet": "^8.1.0",
    "jose": "^6.2.13",
    "mssql": "^12.7.10",
    "pdfkit": "^0.20.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@azure/msal-node": "^7.1.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/fontkit": "^2.0.9",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.3",
    "open": "^11.0.4",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  },
  "optionalDependencies": {
    "msnodesqlv8": "^5.6.0"
  }
}
