# Copia este archivo como .env. No contiene secretos.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Se leen al acceder a operaciones protegidas; /health no consulta SQL.
# SQL Server Developer local con autenticación Windows y certificado local.
SQL_DRIVER=windows
SQL_SERVER=localhost
SQL_DATABASE=jorge_motors_dev
SQL_TRUST_CERTIFICATE=true

# Parte 3: completar manualmente con IDs reales, sin contraseñas ni secretos.
# Mantener comentadas TODAS las ENTRA hasta completar la configuración.
# ENTRA_TENANT_ID=UUID_DEL_DIRECTORIO
# ENTRA_API_CLIENT_ID=UUID_DE_LA_APLICACION_API
# ENTRA_ALLOWED_CLIENT_IDS=UUID_DEL_CLIENTE_LOCAL
# ENTRA_TEST_CLIENT_ID=UUID_DEL_CLIENTE_LOCAL

# Opcional: ruta ABSOLUTA privada fuera de carpetas publicadas; solo desarrollo/test.
# Por defecto: backend/.local-data/attachments (excluido de Git).
# ATTACHMENT_LOCAL_ROOT=C:/ruta/privada/jorge-motors/attachments
# NODE_ENV=production rechaza este adaptador local; Blob privado se integra después.
